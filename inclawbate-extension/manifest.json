{
  "manifest_version": 3,
  "name": "ClawReply — AI Replies for X",
  "version": "2.0.0",
  "description": "Generate smart replies on X/Twitter with customizable personas. Free, powered by Inclawbate.",
  "permissions": ["storage", "activeTab", "clipboardWrite", "clipboardRead"],
  "host_permissions": ["https://x.com/*", "https://twitter.com/*", "https://inclawbate.app/*", "https://www.inclawbate.app/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ClawReply Settings"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "generate-reply": {
      "suggested_key": {
        "default": "Alt+R"
      },
      "description": "Generate a reply for the focused tweet"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
