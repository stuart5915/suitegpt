# Get your GAME API key from https://console.game.virtuals.io/
GAME_API_KEY=your_game_api_key_here

# Inclawbate API base URL (default: https://inclawbate.app/api/inclawbate)
INCLAWBATE_API=https://inclawbate.app/api/inclawbate

# JWT token for agent to submit incubation applications (get from localStorage after logging in)
AGENT_JWT=your_jwt_here
